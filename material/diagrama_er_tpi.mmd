erDiagram

    Pais{
        int id PK
        str nombre
    }

    Plan {
        int id PK
        str nombre
        str descripcion
        float precio
        int cantidad_dispositivos
    }

    Calidad{
        int id PK
        str nombre
        str descripcion
    }

    Plan_calidad{
        int id PK
        int id_Plan FK
        int id_Calidad FK
    }
    
    Tipo_titulo{
        int id PK
        str nombre
        str descripcion
    }

    Titulo {
        int id PK
        str nombre_original
        str descripcion_original
        int id_Tipo_titulo FK
        int id_Pais FK
    }

    Idioma{
        int id PK
        str nombre
        str descripcion
    }

    Idioma_titulo{
        int id PK
        str nombre
        str descripcion
        int id_Idioma FK
        int id_Titulo FK
    }

    Contenido{
        int id PK
        str nombre
        str descripcion
        int seccion
        int orden 
        int id_Titulo FK
    }

    Idioma_contenido{
        int id PK
        int id_Idioma FK
        int id_Contenido FK
    }

    Calidad_idioma_contenido{
        int id PK
        int id_Idioma_contenido FK
        int id_Calidad FK
        blob archivo
    }


    Marca_tarjeta{
        int id PK
        str nombre
        int numero_asignado
        str descripcion
    }

    Metodo_pago {
        int id PK
        str nombre
        str descripcion
    }

    Tarjeta {
        int id PK
        str numero
        str nombre_titular
        date fecha_vencimiento
        int id_Marca_tarjeta FK
        int id_Metodo_pago FK
        bool habilitado
    }

    Usuario {
        int id PK
        str nombre
        str apellido
        str email
        str telefono 
        %%OPC Contiene caracteristica
        str clave 
        %%cifrado
        int id_Pais FK
        int id_Idioma FK
        int id_Tarjeta FK
    
    }

    Registro{
        int id PK
        int id_Usuario FK
        %%cada inicio de sesion genera un token unico que indica donde se ha iniciado sesion, este mismo se almacena en las cookies del navegador para luego poder acceder nuevamente sin necesidad de loguearse
        str token_dispositivo 
        %%indica si el token es valido aún
        str sistema_operativo
        date hora_conexion
        bool estado_sesion
    }

    Suscripcion {
        int id PK
        int id_Usuario FK
        int id_Plan FK
        date fecha_incripcion
        date fecha_cancelacion
        bool habilitado
    }

    Estado_cobro{
        int id PK
        str nombre
        str descripcion
    }

    Cobro{
        int id PK
        int num_factura
        int id_Suscripcion FK
        date fecha_cobro
        int id_Estado FK
        int id_Tarjeta FK 
        int numero_autorizacion
        %%id_tarjeta se saca de suscrpcion a la hora del cobro, y luego se almacena por historial
        float monto
    }


